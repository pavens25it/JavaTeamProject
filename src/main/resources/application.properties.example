# ==============================================================================
# KEC Placement System - Remote Database Configuration (Student 1 -> Student 2)
# ==============================================================================
# Student 1 (Application Host on OCI VM 1) connects to Student 2 (Database Host on OCI VM 2).
#
# Values can be provided via environment variables (recommended for production/OCI):
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_TYPE (mysql or postgresql)
# Or configured directly here for local development.

db.type=mysql
db.host=localhost
db.port=3306
db.name=kec_placement_db
db.user=kec_placement_user
db.password=KecPlacement@2026
db.ssl=false
